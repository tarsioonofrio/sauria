@file(power.tcl) 19: if {![file exists $WINDOW_FILE]} { error "Missing layer window: $WINDOW_FILE" }
@file(power.tcl) 20: set fp [open $WINDOW_FILE r]
@file(power.tcl) 21: if {[gets $fp start_ns] < 0} { close $fp; error "Empty layer window file" }
@file(power.tcl) 22: if {[gets $fp end_ns] < 0} { close $fp; error "Layer window is missing its end time" }
@file(power.tcl) 23: close $fp
@file(power.tcl) 24: if {![string is double -strict $start_ns] || ![string is double -strict $end_ns] || $end_ns <= $start_ns} {
    error "Invalid layer window: start=$start_ns ns end=$end_ns ns"
}
