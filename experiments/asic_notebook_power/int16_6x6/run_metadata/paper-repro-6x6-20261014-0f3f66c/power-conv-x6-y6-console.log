}
@file(power.tcl) 14: set DB_FILE [file join $RESULTS_ROOT gate_level sauria_asic_top_logic_mapped.db]
@file(power.tcl) 15: set SHM [file join $SIM_CASE gate dut.shm]
@file(power.tcl) 16: set WINDOW_FILE [file join $SIM_CASE gate-layer-window.txt]
@file(power.tcl) 17: if {![file exists $DB_FILE]} { error "Missing Genus database: $DB_FILE" }
