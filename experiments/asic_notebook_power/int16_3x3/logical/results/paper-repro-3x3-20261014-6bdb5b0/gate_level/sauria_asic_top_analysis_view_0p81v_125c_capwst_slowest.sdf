     (INSTANCE df_controller_i.ien_q_reg)
     (DELAY
        (ABSOLUTE
          (PORT CDN (::0.0))
          (PORT CP (::0.0))
          (PORT D (::0.1))
          (COND CP==1'b0&&D==1'b0 (IOPATH CDN Q () (::19)))
          (COND CP==1'b0&&D==1'b1 (IOPATH CDN Q () (::19)))
          (COND CP==1'b1&&D==1'b0 (IOPATH CDN Q () (::19)))
          (COND CP==1'b1&&D==1'b1 (IOPATH CDN Q () (::19)))
          (IOPATH CP Q (::58) (::64))
        )
     )
     (TIMINGCHECK
        (RECREM (posedge CDN) (COND D_SDFCHK (posedge CP)) (::-33) (::53))
        (SETUPHOLD (negedge D) (COND CDN_SDFCHK (posedge CP)) (::10) (::4))
        (SETUPHOLD (posedge D) (COND CDN_SDFCHK (posedge CP)) (::28) (::-13))
     )
  )
